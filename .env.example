# ---------------------------------------------------------------------------
# Price Checker — environment configuration
#
# Copy this file to ".env" and edit the values. The ".env" file is gitignored
# and must never be committed.
# ---------------------------------------------------------------------------

# Django secret key. Generate a fresh one for production:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me-to-a-long-random-string

# Never leave DEBUG=True on the showroom machine if it is reachable from
# outside the local network.
DEBUG=False

# Comma-separated. Add the showroom PC's LAN IP so other devices can reach it.
ALLOWED_HOSTS=127.0.0.1,localhost

# ---------------------------------------------------------------------------
# Database
#
# SQLite is the default and is right for a developer laptop. The settings
# file switches on DB_ENGINE alone, so moving to PostgreSQL needs no code
# change — fill in the block below instead.
#
# PRODUCTION (PostgreSQL):
#   DB_ENGINE=django.db.backends.postgresql
#   DB_NAME=arcapsprice
#   DB_USER=arcapsprice
#   DB_PASSWORD='your-password-here'
#   DB_HOST=127.0.0.1
#   DB_PORT=5432
#
# Quote the password if it contains spaces, so the value is unambiguous.
# Characters like # $ @ are safe unquoted here, but quoting costs nothing and
# removes the question.
#
# Never put a real password in THIS file — .env.example is committed to git.
# It belongs only in .env, which is gitignored.
# ---------------------------------------------------------------------------
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Seconds to hold a PostgreSQL connection open for reuse. Ignored on SQLite.
# Keep it below the server's own idle timeout.
DB_CONN_MAX_AGE=60

# ---------------------------------------------------------------------------
# Tally sync
#
# Shared secret for POST /api/tally-product/. The Tally-side script must send
# this exact value in the "X-API-Key" request header.
# ---------------------------------------------------------------------------
TALLY_API_KEY="MwKTgK4rwcdIF6eGKZJ5eK8vKZpFjSwLaNuH8mBBKbk"#change-me-to-a-long-random-string

# Timezone used for timestamps shown in the admin.
TIME_ZONE=Asia/Kolkata

# ---------------------------------------------------------------------------
# Kiosk access
#
# When True the price-checker screen requires a login. Staff sign in once per
# showroom PC with "Remember this system" ticked and are not asked again —
# the session cookie lasts a year and renews on every request.
#
# Set to False only if the screen is on a physically secured machine and you
# want it to open with no sign-in at all.
# ---------------------------------------------------------------------------
KIOSK_REQUIRE_LOGIN=True

# How long a remembered login lasts, in seconds. Default: one year.
SESSION_COOKIE_AGE=31536000

# Set True only when serving over HTTPS.
SESSION_COOKIE_SECURE=False